# Public API origin used by browser-side health diagnostics. Never place credentials here.
VITE_API_BASE_URL=/api/v1

# Public Leaflet tiles. Keep attribution appropriate to the chosen provider.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
